          "name": "Search Events",
          "request": {
            "name": "Search Events",
            "description": {
              "content": "Returns events based on the provided search criteria.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "locale",
                  "value": "<string>",
                  "description": "Locale in the form {language}_{country}, e.g. en_US."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Offset into the list of returned events."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "3",
                  "description": "Number of events to return."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "desc",
                  "description": "Sort direction."
                },
                {
                  "disabled": false,
                  "key": "sort_on",
                  "value": "popularity",
                  "description": "Field to sort events on."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<integer>",
                  "description": "Unix timestamp lower bound for event start time."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<integer>",
                  "description": "Unix timestamp upper bound for event start time."
                },
                {
                  "disabled": false,
                  "key": "categories",
                  "value": "<string>",
                  "description": "Comma-delimited list of event category aliases."
                },
                {
                  "disabled": false,
                  "key": "is_free",
                  "value": "<boolean>",
                  "description": "Filter for free events."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Geographic area to search for events."
                },
                {
                  "disabled": false,
                  "key": "latitude",
                  "value": "<double>",
                  "description": "Latitude of the search center."
                },
                {
                  "disabled": false,
                  "key": "longitude",
                  "value": "<double>",
                  "description": "Longitude of the search center."
                },
                {
                  "disabled": false,
                  "key": "radius",
                  "value": "<integer>",
                  "description": "Search radius in meters. Maximum 40000."
                },
                {
                  "disabled": false,
                  "key": "excluded_events",
                  "value": "<string>",
                  "description": "Comma-delimited list of event ids to exclude."
                }
              ],
              "variable": []
            },
